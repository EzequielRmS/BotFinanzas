# Copiá este archivo como .env (en la misma carpeta que bot.py) y completá los valores.
# El .env NO se sube a GitHub.

# Token que te da @BotFather
TELEGRAM_TOKEN=tu_token_de_telegram

# API key de Google AI Studio (https://aistudio.google.com/apikey)
GEMINI_API_KEY=tu_api_key_de_gemini

# Modelo de Gemini a usar
GEMINI_MODEL=gemini-3.6-flash

# (Opcional) Archivo de la base de datos SQLite
DB_PATH=historial.db
